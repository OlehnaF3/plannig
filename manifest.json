{
  "manifest_version": 3,
  "name": "Управление планированием",
  "version": "3.3",
  "description": "Ребилд очереди планирования и сброс волн",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": ["http://wms:8080/*","http://fl-v7-test:8080/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
    "icons": {
	"16": "icons/icon-16.png",
	"32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
	"64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
  {
    "resources": ["inject.js"],
    "matches": ["http://wms:8080/*","http://fl-v7-test:8080/*"]
  }
],
  "content_scripts": [
    {
      "matches": ["http://wms:8080/*","http://fl-v7-test:8080/*"],
      "js": ["config.js","utils.js","content.js"],
      "run_at": "document_start"
    }
  ]
}